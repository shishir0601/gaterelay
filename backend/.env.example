# Copy this file to .env and adjust as needed. Never commit the real .env.

# SQLite file path (relative to backend/). The default is fine for local development.
DATABASE_URL=sqlite:///./gaterelay.db

# Used to sign JWTs. The fallback in auth.py is fine for local development ONLY --
# generate a real random value for anything beyond that, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me-in-production

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173
